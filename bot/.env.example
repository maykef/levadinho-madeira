# Copy to bot/.env (git-ignored) and fill in. Never commit real values: GitHub Pages publishes bot/.
# Comments on their own lines only: app.py reads everything after "=" as the value.

# ---- Meta Cloud API (WhatsApp Business) — account banned since 2026-09-30, kept for when it's back
# System User access token (WhatsApp → API Setup). Empty = the watchdog skips the Meta check.
WA_TOKEN=
# The bot number's Phone number ID, and the WABA id
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# App settings → Basic → App secret (verifies X-Hub-Signature-256)
WA_APP_SECRET=
# Any string; paste the same one into Meta's webhook form
WA_VERIFY_TOKEN=

# ---- Twilio WhatsApp Sandbox (README "Twilio sandbox"). SID, token and FROM all set = Twilio is
# configured: start.sh only warns about the Meta token and the watchdog skips the Meta check.
# Twilio console → Account Info → Account SID (AC…) and Auth Token (signs webhooks, authenticates sends)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox's shared number
TWILIO_WA_FROM=whatsapp:+14155238886
# Exactly the URL saved in the sandbox's "When a message comes in" field: Twilio signs THIS URL
TWILIO_WEBHOOK_URL=https://microscopy-rig-system.tail53cc58.ts.net/levadinho/twilio

# ---- Analytics (Postgres + PostGIS in the levadinho-db container), e.g.
# postgresql://user:password@127.0.0.1:5433/levadinho
DB_URL=

# ---- Optional overrides (defaults in brain.py / llm_control.py / analytics.py)
# LLM_URL=http://127.0.0.1:8001/v1/chat/completions
# LLM_MODEL=levadinho
# STATUS_URL=https://levadinho-madeira.com/status.json
# GUIDE_URL=https://microscopy-rig-system.tail53cc58.ts.net/levadinho/guide/
# LLM_ON_DEMAND=1
# LLM_AUTO_STOP=1
# LLM_IDLE_MIN=30
# LLM_GPU_FREE_GB=88
# LLM_RETRY_S=300
